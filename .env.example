# ===== 运行配置（./install.sh 会自动生成本文件，也可手工复制）=====
# 复制一份：cp .env.example .env

# 管理员登录密码。首次启动写入数据库，之后改这里无效（用页面「修改密码」）
WB_ADMIN_PASS=请改成你自己的强密码

# 宿主机端口（容器内部固定 8787）
WB_HOST_PORT=8787

# 容器名，多实例并存时改一下
WB_NAME=workbench

# 时区
TZ=Asia/Shanghai

# 1 = 首次启动导入演示数据（只看效果用）
WB_SEED=0

# 1 = 开启模拟身份登录，仅本地联调，生产必须 0
WB_DEV_LOGIN=0
